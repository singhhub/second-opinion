# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# API key generated from your local OmniRoute dashboard:
# http://localhost:20128/dashboard/api-manager
OMNIROUTE_API_KEY=your-omniroute-api-key-here

# Only needed if your OmniRoute instance runs on a non-default host/port.
# OMNIROUTE_API_URL=http://localhost:20128/v1/chat/completions

# Direct-call API keys (backend/llm_client.py) — used instead of OmniRoute
# wherever real patient/medical text must not pass through the OmniRoute proxy.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
